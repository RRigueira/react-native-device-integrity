{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build:android": {
      "env": [
        "ANDROID_HOME",
        "ORG_GRADLE_PROJECT_newArchEnabled"
      ],
      "inputs": [
        "package.json",
        "app.json",
        "src/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/src/**",
        "!$TURBO_ROOT$/src/**/__tests__/**",
        "$TURBO_ROOT$/app.plugin.js",
        "$TURBO_ROOT$/plugin/src/**",
        "!$TURBO_ROOT$/plugin/src/**/__tests__/**",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "!$TURBO_ROOT$/android/app/build/**",
        "!$TURBO_ROOT$/android/.gradle/**",
        "!$TURBO_ROOT$/android/.cxx/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "app.json",
        "src/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/src/**",
        "!$TURBO_ROOT$/src/**/__tests__/**",
        "$TURBO_ROOT$/app.plugin.js",
        "$TURBO_ROOT$/plugin/src/**",
        "!$TURBO_ROOT$/plugin/src/**/__tests__/**",
        "$TURBO_ROOT$/ios/**",
        "$TURBO_ROOT$/*.podspec",
        "!$TURBO_ROOT$/ios/build/**"
      ],
      "outputs": []
    }
  }
}
